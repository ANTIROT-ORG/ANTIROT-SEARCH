# ── Antirot environment ────────────────────────────────────────────
# Copy to web/.env — never commit real keys.

# Code tab — GitHub Search API (classic token with public_repo, or
# fine-grained token with "code" read access)
GITHUB_TOKEN=

# Videos tab — YouTube Data API v3 key
YOUTUBE_API_KEY=

# Research providers (optional, polite-pool email)
OPENALEX_MAILTO=you@example.com

# Cache (optional — in-process fallback used when unset)
REDIS_URL=

# Tantivy serving index (optional — falls back to SQLite FTS5 when unset).
# Build: cd rust_search && cargo build --release
# Sync:  ratsearch_index sync --db search/data/local.db --index search/data/tantivy
# Serve: ratsearch_index serve --index search/data/tantivy --port 8090
TANTIVY_URL=

# Golden-layer database (optional — local SQLite used when unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DB_PATH=../search/data/local.db

# Raw-layer archive (optional)
HF_DATASET_REPO=TheBoringRats/ratsearch-raw

# Fast tier — MotherDuck cloud token (optional; without it the app queries the
# local golden SQLite/DuckDB tier instead)
MOTHERDUCK_TOKEN=
