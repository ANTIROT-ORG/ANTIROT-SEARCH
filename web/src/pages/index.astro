        ${r.language ? `<span class="clang">${esc(r.language)}</span>` : ''}
      </div>
      ${r.snippet ? `<pre class="cpre">${esc(r.snippet)}</pre>` : ''}
      <a class="clink" href="${esc(r.url)}" target="_blank" rel="noopener">View Source on GitHub →</a>
    </div>`).join('')}</div>`;
