  const links = (k.sitelinks || []).slice(0, 6);

  return `<div class="kp-card">
    <div class="kp-header">
      <div class="kp-tag-row">
        <span class="kp-tag">Knowledge Panel</span>
        ${k.entity_id ? `<span class="kp-qid">${esc(k.entity_id)}</span>` : ''}
      </div>
      <div class="kp-title-row">
        <h2 class="kp-title">${esc(k.title)}</h2>
        ${k.url ? `<a href="${esc(k.url)}" target="_blank" rel="noopener" class="kp-ext-link" title="Open source">
