function hostOf(u: string): string {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; }
}

function hl(text: string, tokens: string[]): string {
  if (!text || !tokens.length) return esc(text);
  let r = esc(text);
  for (const t of tokens) {
    if (t.length < 2) continue;
    const e = t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    r = r.replace(new RegExp(`\\b(${e})\\b`, 'gi'), '<mark>$1</mark>');
  }
  return r;
}

function esc(s: string): string {
  if (!s) return '';
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

// Auto-detect country/location
try {
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
  if (tz.includes('Dhaka') || tz.includes('Asia/Dhaka')) {
    $('footer-loc').textContent = 'Bangladesh';
  } else if (tz) {
    const city = tz.split('/')[1]?.replace(/_/g, ' ') || 'Global';
    $('footer-loc').textContent = city;
  }
} catch {}

// Global keyboard shortcut '/' to focus search
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== qIn) {
    e.preventDefault();
    qIn.focus();
    qIn.select();
  }
});

// Initialize from URL
(function bootFromUrl() {
  const params = new URLSearchParams(location.search);
  const initV = params.get('vertical');
  const initQ = params.get('q');
  if (initV && ['all', 'images', 'videos', 'news', 'maps', 'academic', 'code', 'products'].includes(initV)) {
    vert = initV;
    navEl.querySelectorAll('.n').forEach(t => t.classList.toggle('on', (t as HTMLElement).dataset.v === vert));
  }
  if (initQ && initQ.trim()) {
    qIn.value = initQ;
    xBtn.classList.add('on');
    const initP = Math.max(parseInt(params.get('page') || '1', 10) || 1, 1);
    doSearch(initQ, initP);
  }
})();
</script>
