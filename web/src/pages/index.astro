}

function webCard(r: any, tokens: string[]): string {
  const dom = hostOf(r.url);
  const crumb = (() => {
    try {
      const u = new URL(r.url);
      const segs = u.pathname.split('/').filter(Boolean).slice(-2).map(s => {
        let dec = s;
        try { dec = decodeURIComponent(s); } catch {}
        return dec.replace(/[-_]+/g, ' ');
      });
      return segs.length ? `${dom} › ${segs.join(' › ')}` : dom;
    } catch { return dom; }
  })();
  const badge = r.provider === 'duckdb'
    ? '<span class="fast-pill"><svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Fast Tier</span>'
    : `<span class="prov-pill">${esc(r.provider)}</span>`;
  const sl = (r.sitelinks || []).length
    ? `<div class="sl">${r.sitelinks.slice(0, 4).map((s: any) => `<a href="${esc(s.url)}" target="_blank" rel="noopener">${esc(s.title || s.url)}</a>`).join('')}</div>`
    : '';

  return `<div class="rcard">
    <div class="rh">
      <svg class="r-favicon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span class="rsrc">${esc(crumb)}</span>
      ${badge}
    </div>
    <a href="${esc(r.url)}" target="_blank" rel="noopener" class="rtitle">${esc(r.title)}</a>
    <div class="rsnip">${hl(r.snippet || '', tokens)}</div>
    ${sl}
  </div>`;
}

function renderPhotos(d: any, q: string) {
  const tokens = q.split(/\s+/).filter(Boolean);
  resEl.innerHTML = `<div class="igrid">${d.results.map((r: any) => {
    const thumb = r.thumbnail || r.image_url || '';
    return `<a class="icard" href="${esc(r.url)}" target="_blank" rel="noopener">
      ${thumb ? `<img src="${esc(thumb)}" alt="${esc(r.title)}" loading="lazy" />` : ''}
      <div class="ii">
        <div class="it">${hl(r.title || '', tokens)}</div>
        <div class="is">${esc(r.source_name || r.provider)}</div>
