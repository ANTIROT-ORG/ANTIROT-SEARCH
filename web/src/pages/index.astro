<script>
const API = '';
let vert = 'all';
let lastQ = '';
let acI = -1;
let acD: any[] = [];
let humanModeOnly = true;
let activeWhen = 'any';

const $ = (s: string) => document.getElementById(s)!;
const app = $('app'), qIn = $('q') as HTMLInputElement, xBtn = $('x'), acEl = $('ac'),
  navEl = $('nav'), infoEl = $('info'), interpEl = $('interp'), resEl = $('res'), pgEl = $('pg'),
  relEl = $('rel'), stEl = $('st'), empEl = $('emp'), dymEl = $('dym'), opsEl = $('ops');

// 9-dot Verticals Hub App Grid Toggle
const btnApps = $('btn-apps');
const appsDropdown = $('apps-dropdown');
btnApps.addEventListener('click', (e) => {
  e.stopPropagation();
  appsDropdown.classList.toggle('on');
});
document.addEventListener('click', (e) => {
  if (!appsDropdown.contains(e.target as Node) && e.target !== btnApps) {
    appsDropdown.classList.remove('on');
  }
});

// Voice Search
const micBtn = $('btn-mic');
let recognition: any = null;
if (typeof window !== 'undefined' && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
  const SpeechRec = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  recognition = new SpeechRec();
  recognition.continuous = false;
  recognition.interimResults = false;
  recognition.lang = 'en-US';

  recognition.onresult = (event: any) => {
    const text = event.results[0][0].transcript;
    qIn.value = text;
    micBtn.classList.remove('listening');
    doSearch(text);
  };
  recognition.onerror = () => { micBtn.classList.remove('listening'); };
  recognition.onend = () => { micBtn.classList.remove('listening'); };
}

micBtn.addEventListener('click', () => {
  if (!recognition) {
    alert('Voice search is not supported in this browser. Please use Chrome or Edge.');
    return;
  }
  if (micBtn.classList.contains('listening')) {
    recognition.stop();
    micBtn.classList.remove('listening');
  } else {
    micBtn.classList.add('listening');
    recognition.start();
  }
});

// Visual Search (Lens & Yandex) Modal
const lensBtn = $('btn-lens');
const lensModal = $('lens-modal');
const lensClose = $('lens-close');
const lensUrlInput = $('lens-url-input') as HTMLInputElement;
const btnLensSearch = $('btn-lens-search');
const lensDropzone = $('lens-dropzone');
const lensFileInput = $('lens-file-input') as HTMLInputElement;

lensBtn.addEventListener('click', () => { lensModal.classList.add('on'); lensUrlInput.focus(); });
lensClose.addEventListener('click', () => { lensModal.classList.remove('on'); });
lensModal.addEventListener('click', (e) => { if (e.target === lensModal) lensModal.classList.remove('on'); });

btnLensSearch.addEventListener('click', () => {
  const imgUrl = lensUrlInput.value.trim();
  if (!imgUrl) return;
  lensModal.classList.remove('on');
  const target = `https://yandex.com/images/search?rpt=imageview&url=${encodeURIComponent(imgUrl)}`;
  window.open(target, '_blank');
});

lensDropzone.addEventListener('click', () => lensFileInput.click());
lensFileInput.addEventListener('change', () => {
  if (lensFileInput.files && lensFileInput.files[0]) {
    alert(`File "${lensFileInput.files[0].name}" queued for visual reverse search.`);
    lensModal.classList.remove('on');
  }
});

// Human Mode Toggle
const aiModeBtn = $('btn-ai-mode');
const aiModeLabel = $('ai-mode-label');
aiModeBtn.addEventListener('click', () => {
  humanModeOnly = !humanModeOnly;
  if (humanModeOnly) {
    aiModeBtn.classList.remove('federated');
    aiModeLabel.textContent = 'Human Mode';
  } else {
    aiModeBtn.classList.add('federated');
    aiModeLabel.textContent = 'Federated';
  }
});

// Trending Chips Click Handlers
document.querySelectorAll('.chip-btn').forEach(btn => {
  btn.addEventListener('click', (e) => {
    const query = (e.currentTarget as HTMLElement).dataset.q || '';
    if (query) {
      qIn.value = query;
      doSearch(query);
    }
  });
});

// Bangla / English Language Toggle
const langToggle = $('lang-toggle');
langToggle.addEventListener('click', () => {
  if (langToggle.textContent === 'বাংলা') {
    langToggle.textContent = 'English';
    $('btn-search').textContent = 'অ্যান্টিরোট অনুসন্ধান';
    $('btn-lucky').textContent = 'আমি সৌভাগ্যবান';
    qIn.placeholder = 'খাঁটি মানব জ্ঞান খুঁজুন...';
  } else {
    langToggle.textContent = 'বাংলা';
    $('btn-search').textContent = 'Antirot Search';
    $('btn-lucky').textContent = "I'm Feeling Lucky";
    qIn.placeholder = 'Search genuine human knowledge, code, papers...';
  }
});

// Header Tab Shortcuts
document.querySelectorAll('.tab-switch-btn').forEach(btn => {
  btn.addEventListener('click', (e) => {
    const v = (e.currentTarget as HTMLElement).dataset.v || 'images';
    vert = v;
    appsDropdown.classList.remove('on');
    navEl.querySelectorAll('.n').forEach(t => t.classList.toggle('on', (t as HTMLElement).dataset.v === vert));
    if (qIn.value.trim()) doSearch(qIn.value);
    else qIn.focus();
  });
});

// I'm Feeling Lucky
$('btn-lucky').addEventListener('click', async () => {
  const q = qIn.value.trim();
  if (!q) return;
  try {
    const res = await fetch(`${API}/api/search?q=${encodeURIComponent(q)}&vertical=all&limit=1`);
    const data = await res.json();
    if (data.results && data.results[0] && data.results[0].url) {
      window.location.href = data.results[0].url;
      return;
    }
  } catch {}
  doSearch(q);
});

$('btn-search').addEventListener('click', () => doSearch(qIn.value));

xBtn.addEventListener('input', () => xBtn.classList.toggle('on', qIn.value.length > 0));
xBtn.addEventListener('click', () => { qIn.value = ''; xBtn.classList.remove('on'); acEl.classList.remove('on'); qIn.focus(); });

navEl.addEventListener('click', (e) => {
  const b = (e.target as HTMLElement).closest('.n') as HTMLElement;
  if (!b) return;
  navEl.querySelectorAll('.n').forEach(t => t.classList.remove('on'));
  b.classList.add('on');
  vert = b.dataset.v || 'all';
  if (lastQ) doSearch(lastQ, 1);
});

function enterSearch() {
  if (app.classList.contains('search-mode')) return;
  app.classList.remove('landing');
  app.classList.add('search-mode');
  const tb = document.createElement('div');
  tb.className = 'topbar';
  tb.innerHTML = `<a href="/" class="logo-sm">ANTIROT<span>.</span></a>`;
  const sw = document.querySelector('.sw')!;
  app.insertBefore(tb, sw);
  tb.appendChild(sw);
  navEl.classList.add('on');
}

let _acT: any = null;
qIn.addEventListener('input', () => {
  xBtn.classList.toggle('on', qIn.value.length > 0);
  if (_acT) clearTimeout(_acT);
  const v = qIn.value.trim();
  if (v.length < 2) { acEl.classList.remove('on'); return; }
  _acT = setTimeout(() => fetchAC(v), 150);
});

qIn.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') { acEl.classList.remove('on'); doSearch(qIn.value); return; }
  if (e.key === 'Escape') { acEl.classList.remove('on'); return; }
  if (acEl.classList.contains('on')) {
    if (e.key === 'ArrowDown') { e.preventDefault(); acI = Math.min(acI + 1, acD.length - 1); hlAC(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); acI = Math.max(acI - 1, 0); hlAC(); }
  }
});

function hlAC() {
  acEl.querySelectorAll('.ac-i').forEach((el, i) => el.classList.toggle('hl', i === acI));
  if (acI >= 0 && acD[acI]) qIn.value = acD[acI].title || '';
}

async function fetchAC(q: string) {
  try {
    const r = await fetch(`${API}/api/suggest?q=${encodeURIComponent(q)}&limit=6`);
    if (!r.ok) return;
    const d = await r.json();
    acD = (d.suggestions || []).slice(0, 6);
    if (!acD.length) { acEl.classList.remove('on'); return; }
    acEl.innerHTML = acD.map((x: any, i: number) => {
      const dom = (() => { try { return new URL(x.url).hostname; } catch { return ''; } })();
      return `<div class="ac-i" data-i="${i}"><span class="ac-t">${esc(x.title)}</span><span class="ac-d">${esc(dom)}</span></div>`;
    }).join('');
    acEl.classList.add('on');
    acI = -1;
    acEl.querySelectorAll('.ac-i').forEach(el => el.addEventListener('click', () => {
      const i = parseInt(el.getAttribute('data-i') || '0');
      qIn.value = acD[i].title || acD[i].url;
      acEl.classList.remove('on');
      doSearch(qIn.value);
    }));
  } catch {}
}

document.addEventListener('click', (e) => {
  if (!acEl.contains(e.target as Node) && e.target !== qIn) acEl.classList.remove('on');
});

$('go').addEventListener('click', () => doSearch(qIn.value));

let searchSeq = 0;
function showMore() { document.getElementById('morebar')?.classList.add('on'); }
function hideMore() { document.getElementById('morebar')?.classList.remove('on'); }

async function doSearch(raw: string, pg = 1) {
  const q = raw.trim();
  if (!q) return;
  lastQ = q;
  acEl.classList.remove('on');
  enterSearch();
  resEl.innerHTML = '';
  infoEl.textContent = '';
  infoEl.classList.remove('on');
  interpEl.innerHTML = '';
  interpEl.classList.remove('on');
  empEl.classList.remove('on');
  relEl.innerHTML = '';
  relEl.classList.remove('on');
  dymEl.innerHTML = '';
  dymEl.classList.remove('on');
  opsEl.innerHTML = '';
  opsEl.classList.remove('on');
  stEl.className = 'st on';
  stEl.innerHTML = '<span class="spin"></span> Searching verified human knowledge...';
  pgEl.innerHTML = '';
  hideMore();

  history.replaceState(null, '', `${location.pathname}?q=${encodeURIComponent(q)}&vertical=${vert}${pg > 1 ? `&page=${pg}` : ''}`);
  const whenParam = (activeWhen && activeWhen !== 'any') ? `&when=${activeWhen}` : '';
  const base = `${API}/api/search?q=${encodeURIComponent(q)}&vertical=${vert}&page=${pg}${whenParam}`;
  const my = ++searchSeq;

  const paint = (d: any) => {
    stEl.className = 'st';
    stEl.innerHTML = '';
    if (!d.results?.length) {
      empEl.innerHTML = `<h2>No verified human results found for "${esc(q)}"</h2><p>Try broader terms or switch verticals above.</p>`;
      empEl.classList.add('on');
      infoEl.textContent = `0 results (${d.duration_ms || 0}ms)`;
      infoEl.classList.add('on');
      return;
    }
    const active = (d.providers || []).filter((p: any) => p.count > 0).map((p: any) => p.name);
    infoEl.textContent = `About ${d.total_results || d.results.length} results (${d.duration_ms || 0}ms · ${active.join(', ') || 'verified human knowledge'})`;
    infoEl.classList.add('on');

    renderInterp(d.interpretation);
    renderDym(d.did_you_mean);
    renderOps(d.operators, d.when);

    if (vert === 'images') renderPhotos(d, q);
    else if (vert === 'videos') renderVideos(d, q);
    else if (vert === 'news') renderNews(d, q);
    else if (vert === 'code') renderCode(d);
    else if (vert === 'maps') renderMaps(d);
    else if (vert === 'academic') renderAcademic(d);
    else if (vert === 'products') renderProducts(d);
    else renderAll(d, q);

    renderRelated(d.related);
  };

  const paintFull = (d: any) => {
    paint(d);
    renderPagination(d, pg);
    hideMore();
  };

  // Progressive Fast-Tier Loading (<30ms)
  let fullPainted = false;
  if (pg === 1 && vert === 'all') {
    fetch(`${base}&fast=1`)
      .then(r => r.ok ? r.json() : null)
      .then(fastData => {
        if (!fastData || searchSeq !== my || fullPainted) return;
        paint(fastData);
        showMore();
      })
      .catch(() => {});
  }

  try {
    const res = await fetch(base);
    if (!res.ok) throw new Error('Search failed');
    const data = await res.json();
    if (searchSeq !== my) return;
    fullPainted = true;
    paintFull(data);
  } catch (e: any) {
    if (searchSeq !== my) return;
    stEl.className = 'st';
    stEl.innerHTML = '';
    empEl.innerHTML = `<h2>Search error</h2><p>${esc(e?.message || 'Failed to reach search backend')}</p>`;
    empEl.classList.add('on');
    hideMore();
  }
}

function renderPagination(d: any, cur: number) {
  pgEl.innerHTML = '';
  const totalPages = Math.max(1, Math.min(Number(d.pages_available) || 1, 50));
  const pageSize = d.page_size || 20;
  const fullPage = (d.results || []).length >= pageSize;
  const lastPage = fullPage ? totalPages : cur;
  const hasNext = !!d.pagination && fullPage && cur < totalPages;
  if (cur <= 1 && lastPage <= 1) return;

  const go = (p: number) => {
    if (!lastQ) return;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    doSearch(lastQ, p);
  };

  if (cur > 1) {
    const prev = document.createElement('button');
    prev.className = 'pgb nav-btn';
    prev.textContent = '← Previous';
    prev.onclick = () => go(cur - 1);
    pgEl.appendChild(prev);
  }

  const pages: number[] = [];
  for (let p = 1; p <= lastPage; p++) {
    if (p === 1 || p === lastPage || Math.abs(p - cur) <= 1) pages.push(p);
  }
  let last = 0;
  for (const p of pages) {
    if (p - last > 1) {
      const gap = document.createElement('span');
      gap.className = 'pgb ellipsis';
      gap.textContent = '…';
      pgEl.appendChild(gap);
    }
    const num = document.createElement('button');
    num.className = 'pgb num' + (p === cur ? ' cur' : '');
    num.textContent = String(p);
    if (p === cur) num.setAttribute('aria-current', 'page');
    num.onclick = () => { if (p !== cur) go(p); };
    pgEl.appendChild(num);
    last = p;
  }

  if (hasNext) {
    const next = document.createElement('button');
    next.className = 'pgb nav-btn';
    next.textContent = 'Next page →';
    next.onclick = () => go(cur + 1);
    pgEl.appendChild(next);
  }
}

function renderAll(d: any, q: string) {
  const tokens = q.toLowerCase().split(/\s+/).filter(Boolean);

  const dictHtml = d.dictionary ? renderDictionaryHtml(d.dictionary) : '';
  const answerHtml = (!d.dictionary && d.answer) ? renderAnswerHtml(d.answer) : '';
  const paaHtml = (d.people_also_ask && d.people_also_ask.length) ? renderPaaHtml(d.people_also_ask) : '';
  const webHtml = d.results.map((r: any) => webCard(r, tokens)).join('');
  const knowledgeHtml = d.knowledge_card ? renderKnowledgeHtml(d.knowledge_card) : '';
  const hasSide = !!(dictHtml || knowledgeHtml);

  resEl.innerHTML = `<div class="serp-layout${hasSide ? '' : ' no-side'}">
    <div class="serp-main">
      ${answerHtml}
      ${paaHtml}
      <div class="serp-web-list">
        ${webHtml}
      </div>
    </div>
    ${hasSide ? `<aside class="serp-sidebar">${dictHtml}${knowledgeHtml}</aside>` : ''}
  </div>`;

  wireInteractiveComponents();
}

function wireInteractiveComponents() {
  wireAudioPlayer();
  wirePaa();
}

function wireAudioPlayer() {
  const btn = $('dict-audio-play');
  if (!btn) return;
  btn.addEventListener('click', () => {
    btn.classList.add('playing');
    const audioUrl = btn.getAttribute('data-audio') || '';
    const word = btn.getAttribute('data-word') || '';
    if (audioUrl) {
      const audio = new Audio(`/api/dict/audio?u=${encodeURIComponent(audioUrl)}`);
      audio.play().catch(() => {
        speakWord(word);
      });
      audio.onended = () => btn.classList.remove('playing');
      audio.onerror = () => {
        btn.classList.remove('playing');
        speakWord(word);
      };
      setTimeout(() => btn.classList.remove('playing'), 3500);
    } else if (word) {
      speakWord(word);
      setTimeout(() => btn.classList.remove('playing'), 1200);
    }
  });
}

function speakWord(w: string) {
  if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
    const utt = new SpeechSynthesisUtterance(w);
    utt.lang = 'en-US';
    window.speechSynthesis.speak(utt);
  }
}

function wirePaa() {
  document.querySelectorAll('.paa-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const item = (e.currentTarget as HTMLElement).closest('.paa-item');
      if (!item) return;
      const isOpen = item.classList.toggle('open');
      (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(isOpen));
    });
  });
}

function renderDefinitionsByPos(defs: any[]): string {
  if (!defs || !defs.length) return '';
  const byPos: Record<string, any[]> = {};
  for (const d of defs) {
    const pos = d.pos || 'definition';
    if (!byPos[pos]) byPos[pos] = [];
    byPos[pos].push(d);
  }
  let html = '';
  for (const [pos, items] of Object.entries(byPos)) {
    html += `<div class="dict-pos-group">
      <div class="dict-pos-tag">${esc(pos)}</div>
      <ol class="dict-ol">
        ${items.map((it: any) => `
          <li class="dict-li">
            <div>${esc(it.text)}</div>
            ${it.example ? `<div class="dict-example">&ldquo;${esc(it.example)}&rdquo;</div>` : ''}
          </li>
        `).join('')}
      </ol>
    </div>`;
  }
  return html;
}

