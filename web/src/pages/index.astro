  return `<div class="ans-card">
    <div class="ans-header">
      <div class="ans-badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>Featured Human Answer</span>
      </div>
      <span class="ans-source-tag">${esc(ans.source_name || 'Verified')}</span>
    </div>

    <div class="ans-text">${esc(ans.text)}</div>

    <div class="ans-cite">
      <a href="${esc(ans.url)}" target="_blank" rel="noopener" class="ans-cite-title">${esc(ans.title)}</a>
      <span class="ans-cite-url">${esc(hostOf(ans.url))}</span>
