  return `<div class="dict-card">
    <div class="dict-top">
      <div class="dict-badge">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/></svg>
        <span>Dictionary · Wiktionary</span>
      </div>
      <a href="https://en.wiktionary.org/wiki/${encodeURIComponent(dict.word)}" target="_blank" rel="noopener" class="dict-src-link">Wiktionary →</a>
    </div>

    <div class="dict-word-row">
      <h2 class="dict-word">${esc(dict.word)}</h2>
      <button class="dict-audio-btn" id="dict-audio-play" title="Listen to pronunciation" data-audio="${esc(dict.audio_url || '')}" data-word="${esc(dict.word)}" aria-label="Pronounce ${esc(dict.word)}">
        <svg class="dict-speaker-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
        </svg>
        <span class="dict-audio-waves"></span>
      </button>
    </div>

    ${dict.phonetic ? `<div class="dict-phonetic">${esc(dict.phonetic)}</div>` : ''}

    <div class="dict-body">
      ${renderDefinitionsByPos(dict.definitions)}
    </div>

    <div class="dict-footer">
      <span>Human-verified lexicography</span>
      <a href="https://en.wiktionary.org/wiki/${encodeURIComponent(dict.word)}" target="_blank" rel="noopener">Explore full etymology on Wiktionary</a>
    </div>
  </div>`;
}

