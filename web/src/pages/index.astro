---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Antirot — Real Human Knowledge">
  <div id="app" class="landing">
    <!-- Ambient Background Aura -->
    <div class="ambient-bg"></div>

    <!-- Top Bar Navigation -->
    <header class="g-header">
      <div class="g-header-left">
        <a href="/api-docs" class="g-head-link">Docs & API</a>
        <a href="#about" class="g-head-link about-trigger">About</a>
      </div>
      <div class="g-header-right">
        <button type="button" class="g-head-link tab-switch-btn" data-v="images">Images</button>
        <button type="button" class="g-head-link tab-switch-btn" data-v="academic">Research</button>
        
        <!-- 9-dot Verticals Hub App Grid -->
        <div class="apps-menu-wrap">
          <button class="g-icon-btn" id="btn-apps" title="Antirot Search Verticals" aria-label="Search Verticals">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <circle cx="6" cy="6" r="2"/><circle cx="12" cy="6" r="2"/><circle cx="18" cy="6" r="2"/>
              <circle cx="6" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="12" r="2"/>
              <circle cx="6" cy="18" r="2"/><circle cx="12" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
            </svg>
          </button>
          
          <!-- Dropdown Grid of Verticals -->
          <div class="apps-dropdown" id="apps-dropdown">
            <div class="apps-grid">
              <button class="app-item tab-switch-btn" data-v="all">
                <span class="app-icon t-sky"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></span>
                <span class="app-name">General Web</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="images">
                <span class="app-icon t-violet"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></span>
                <span class="app-name">Images</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="news">
                <span class="app-icon t-amber"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg></span>
                <span class="app-name">News RSS</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="maps">
                <span class="app-icon t-emerald"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg></span>
                <span class="app-name">OpenStreetMap</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="academic">
                <span class="app-icon t-blue"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></span>
                <span class="app-name">OpenAlex Papers</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="code">
                <span class="app-icon t-cyan"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><line x1="2" y1="20" x2="22" y2="20"/></svg></span>
                <span class="app-name">GitHub Code</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="products">
                <span class="app-icon t-orange"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                <span class="app-name">Products</span>
              </button>
              <button class="app-item tab-switch-btn" data-v="videos">
                <span class="app-icon t-red"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><polygon points="7 4 20 12 7 20 7 4"/></svg></span>
                <span class="app-name">Videos</span>
              </button>
              <a href="/api-docs" class="app-item">
                <span class="app-icon t-emerald"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
                <span class="app-name">Fast Tier (DuckDB)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- User Avatar Circle -->
        <div class="g-avatar" title="Human Knowledge Explorer">
          <span>A</span>
        </div>
      </div>
    </header>

    <!-- Center Hero -->
    <div class="hero">
      <div class="logo-wrap">
        <h1 class="logo">
          <span class="logo-main">ANTIROT</span>
          <span class="logo-dot">.</span>
        </h1>
        <p class="logo-sub">Curated Human Knowledge · Zero AI Slop</p>
      </div>
    </div>

    <!-- Main Pill Search Container -->
    <div class="sw">
      <div class="sb" id="sb">
        <!-- Search Magnifier Icon -->
        <svg class="si" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>

        <input type="text" id="q" placeholder="Search genuine human knowledge, code, papers..." autofocus autocomplete="off" />
        
        <button class="x" id="x" title="Clear search">&times;</button>
        
        <!-- Microphone Voice Search -->
        <button class="mic-btn" id="btn-mic" title="Voice Search" aria-label="Search by voice">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
            <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
          </svg>
        </button>

        <!-- Visual / Reverse Image Search (Google Lens & Yandex) -->
        <button class="lens-btn" id="btn-lens" title="Search by image (Visual Reverse Search)" aria-label="Search by image">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
            <path d="M9 3L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.17L15 3H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
          </svg>
        </button>

        <!-- Mode Badge -->
        <button class="ai-mode-btn" id="btn-ai-mode" title="Toggle Clean Human Knowledge vs Federated Mode">
          <span class="mode-pulse"></span>
          <span id="ai-mode-label">Human Mode</span>
        </button>

        <!-- Hidden submit trigger for forms -->
        <button class="go" id="go" title="Search" style="display:none;"></button>
      </div>

      <!-- Autocomplete Dropdown -->
      <div class="ac" id="ac"></div>

      <!-- Action Buttons below Search Bar -->
      <div class="g-btn-row" id="btn-row">
        <button type="button" class="g-btn" id="btn-search">Antirot Search</button>
        <button type="button" class="g-btn" id="btn-lucky">I'm Feeling Lucky</button>
      </div>

      <!-- Trending Human Topics Quick Explore -->
      <div class="trending-chips" id="trending-chips">
        <span class="chips-label">Explore:</span>
        <button class="chip-btn" data-q="Photosynthesis">Photosynthesis</button>
        <button class="chip-btn" data-q="Quantum Mechanics">Quantum Mechanics</button>
        <button class="chip-btn" data-q="Rust programming">Rust language</button>
        <button class="chip-btn" data-q="OpenStreetMap">OpenStreetMap</button>
        <button class="chip-btn" data-q="Stanford Philosophy">Philosophy</button>
      </div>

      <!-- Language selector line -->
      <div class="g-lang-line" id="lang-line">
        Antirot offered in: <a href="javascript:void(0)" id="lang-toggle">বাংলা</a>
      </div>
    </div>

    <!-- Navigation Tabs for Search Results -->
    <div class="nav" id="nav">
      <button class="n on" data-v="all">All</button>
      <button class="n" data-v="images">Images</button>
      <button class="n" data-v="videos">Videos</button>
      <button class="n" data-v="news">News</button>
      <button class="n" data-v="maps">Maps</button>
      <button class="n" data-v="academic">Academic</button>
      <button class="n" data-v="code">Code</button>
      <button class="n" data-v="products">Products</button>
    </div>

    <!-- Search Result Panels -->
    <div class="info" id="info"></div>
    <div class="interp" id="interp"></div>
    <div class="dym" id="dym"></div>
    <div class="opsbar" id="ops"></div>
    <div id="res" class="res"></div>
    <div class="more-slot" id="morebar">
      <span class="spin"></span>Bringing in more verified human sources & fast-tier records&hellip;
    </div>
    <div id="rel" class="rel"></div>
    <div id="pg" class="pg"></div>
    <div id="st" class="st"></div>
    <div id="emp" class="emp"></div>

    <!-- Sticky Footer -->
    <footer class="g-footer" id="footer">
      <div class="g-footer-loc">
        <span id="footer-loc">Bangladesh</span>
        <span class="loc-divider">·</span>
        <span class="footer-badge"><span class="fdot"></span>864+ Curated Knowledge Sources</span>
        <span class="loc-divider">·</span>
        <span class="footer-badge"><svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>DuckDB Fast Tier Enabled</span>
      </div>
      <div class="g-footer-links">
        <div class="g-footer-left">
          <a href="/api-docs">API & Docs</a>
          <a href="/search/STRATEGY.md">Methodology</a>
          <a href="/api/stats">Corpus Stats</a>
          <a href="https://commoncrawl.org" target="_blank" rel="noopener">Common Crawl</a>
        </div>
        <div class="g-footer-right">
          <a href="#privacy">Privacy</a>
          <a href="#terms">Terms</a>
          <a href="#settings">Settings</a>
        </div>
      </div>
    </footer>

    <!-- Visual / Reverse Image Search Modal -->
    <div class="lens-modal" id="lens-modal">
      <div class="lens-box">
        <div class="lens-header">
          <div class="lens-title">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#34d399">
              <path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/>
              <path d="M9 3L7.17 5H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2h-3.17L15 3H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
            </svg>
            <span>Visual Search · Lens & Yandex Images</span>
          </div>
          <button class="lens-close" id="lens-close">&times;</button>
        </div>
        <p class="lens-desc">Search any image by URL or file without storing raw binary bytes.</p>
        
        <div class="lens-body">
          <div class="lens-input-wrap">
            <input type="url" id="lens-url-input" placeholder="Paste image link (e.g. https://example.com/leaf.jpg)..." />
            <button type="button" class="lens-submit-btn" id="btn-lens-search">Search</button>
          </div>
          <div class="lens-divider"><span>OR</span></div>
          <div class="lens-dropzone" id="lens-dropzone">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="#9aa0a6">
              <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
            </svg>
            <p>Drag an image here or <label for="lens-file-input" class="lens-file-label">browse file</label></p>
            <input type="file" id="lens-file-input" accept="image/*" style="display:none;" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
/* ── shadcn/ui design tokens (dark theme) ── */
:root {
  --bg: #09090b;
  --sb-bg: #131316;
  --sb-hover: #1a1a1f;
  --border: #2b2b31;
  --border-focus: #10b981;
  --border-subtle: #1f1f24;
  --tx: #fafafa;
  --tx-body: #c9c9d1;
  --tx-sub: #a1a1aa;
  --tx-muted: #71717a;
  --btn-bg: #18181b;
  --btn-hover: #27272a;
  --accent: #10b981;
  --accent-cyan: #22d3ee;
  --accent-blue: #8ab4f8;
  --accent-red: #f87171;
  --card-bg: #101014;
  --link: #8ab4f8;
  --visited: #c58af9;
  --ring: rgba(138, 180, 248, 0.55);
  --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.45), 0 8px 28px rgba(0, 0, 0, 0.28);
  --radius: 14px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg);
  color: var(--tx);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  position: relative;
  overflow-x: hidden;
}
::selection { background: rgba(138, 180, 248, 0.3); color: #fff; }
:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; border-radius: 4px; }
a { color: var(--link); }

/* thin custom scrollbars */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #2e2e35; border-radius: 999px; border: 2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: #3d3d45; }
::-webkit-scrollbar-track { background: transparent; }

/* ── Ambient Radial Lighting ── */
.ambient-bg {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 1000px;
  height: 560px;
  background:
    radial-gradient(ellipse 60% 50% at 50% 0%, rgba(16, 185, 129, 0.1) 0%, transparent 65%),
    radial-gradient(ellipse 45% 40% at 70% 15%, rgba(138, 180, 248, 0.07) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* ── Top Header ── */
.g-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 28px;
  font-size: 14px;
  z-index: 50;
}
.g-header-left, .g-header-right {
  display: flex;
  align-items: center;
  gap: 18px;
}
.g-head-link {
  color: var(--tx-sub);
  text-decoration: none;
  background: none;
  border: none;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  padding: 6px 4px;
  transition: color 0.15s;
}
.g-head-link:hover {
  color: var(--tx);
}
.g-icon-btn {
  background: none;
  border: none;
  color: var(--tx-sub);
  padding: 8px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, color 0.15s;
}
.g-icon-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}

/* 9-dot Apps Hub */
.apps-menu-wrap {
  position: relative;
}
.apps-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 10px);
  right: -20px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
  width: 290px;
  box-shadow: var(--shadow-card);
  z-index: 200;
}
.apps-dropdown.on {
  display: block;
  animation: ddIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes ddIn {
  from { opacity: 0; transform: translateY(-6px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.apps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
}
.app-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: none;
  color: var(--tx);
  padding: 10px 6px;
  border-radius: 12px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.15s;
}
.app-item:hover {
  background: rgba(255, 255, 255, 0.05);
}
.app-item:hover .app-name { color: var(--tx); }
.app-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--tx-sub);
  transition: transform 0.15s, border-color 0.15s, background 0.15s;
}
.app-item:hover .app-icon {
  transform: translateY(-2px);
  border-color: var(--border);
  background: rgba(255, 255, 255, 0.07);
}
.app-icon.t-sky { color: #38bdf8; background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.18); }
.app-icon.t-violet { color: #a78bfa; background: rgba(167, 139, 250, 0.1); border-color: rgba(167, 139, 250, 0.18); }
.app-icon.t-amber { color: #fbbf24; background: rgba(251, 191, 36, 0.1); border-color: rgba(251, 191, 36, 0.18); }
.app-icon.t-emerald { color: #34d399; background: rgba(52, 211, 153, 0.1); border-color: rgba(52, 211, 153, 0.18); }
.app-icon.t-blue { color: #60a5fa; background: rgba(96, 165, 250, 0.1); border-color: rgba(96, 165, 250, 0.18); }
.app-icon.t-cyan { color: #22d3ee; background: rgba(34, 211, 238, 0.1); border-color: rgba(34, 211, 238, 0.18); }
.app-icon.t-orange { color: #fb923c; background: rgba(251, 146, 60, 0.1); border-color: rgba(251, 146, 60, 0.18); }
.app-icon.t-red { color: #f87171; background: rgba(248, 113, 113, 0.1); border-color: rgba(248, 113, 113, 0.18); }
.app-name { font-size: 11px; text-align: center; color: var(--tx-sub); line-height: 1.3; }

.g-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
  color: #000;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

/* ── Landing Page View ── */
.landing {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding-top: 130px;
  position: relative;
  z-index: 10;
}
.hero {
  margin-bottom: 30px;
  text-align: center;
}
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  font-size: 5.6rem;
  font-weight: 800;
  letter-spacing: -1.5px;
  line-height: 1;
  color: #ffffff;
  user-select: none;
  display: flex;
  align-items: baseline;
}
.logo-main {
  background: linear-gradient(180deg, #ffffff 40%, #e2e8f0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.logo-dot {
  color: var(--accent);
  font-size: 5.6rem;
  line-height: 1;
}
.logo-sub {
  color: var(--tx-sub);
  font-size: 0.95rem;
  margin-top: 12px;
  letter-spacing: 0.5px;
  font-weight: 400;
}

/* ── Pill Search Box ── */
.sw {
  position: relative;
  width: 100%;
  max-width: 660px;
  padding: 0 16px;
}
.sb {
  display: flex;
  align-items: center;
  background: var(--sb-bg);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 4px 10px 4px 18px;
  height: 54px;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
}
.sb:hover {
  background: var(--sb-hover);
  border-color: #3f3f46;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
}
.sb:focus-within {
  background: var(--sb-hover);
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.16), 0 8px 26px rgba(0, 0, 0, 0.5);
}
.si {
  color: var(--tx-muted);
  margin-right: 14px;
  flex-shrink: 0;
}
#q {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--tx);
  font-size: 16px;
  font-family: inherit;
  min-width: 0;
}
#q::placeholder {
  color: var(--tx-muted);
}
.x {
  display: none;
  background: none;
  border: none;
  color: var(--tx-muted);
  font-size: 20px;
  cursor: pointer;
  padding: 4px 8px;
}
.x.on { display: block; }

.mic-btn, .lens-btn {
  background: none;
  border: none;
  color: var(--tx-sub);
  cursor: pointer;
  padding: 8px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s, color 0.15s;
}
.mic-btn:hover, .lens-btn:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.07);
  transform: scale(1.05);
}
.mic-btn.listening {
  color: var(--accent-red);
  animation: pulse 1s infinite alternate;
}
@keyframes pulse {
  from { transform: scale(1); opacity: 0.8; }
  to { transform: scale(1.2); opacity: 1; }
}

/* Mode Badge */
.ai-mode-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: #34d399;
  padding: 6px 12px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  margin-left: 6px;
  white-space: nowrap;
  transition: all 0.2s;
}
.mode-pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 6px var(--accent);
}
.ai-mode-btn.federated {
  background: rgba(96, 165, 250, 0.12);
  border-color: rgba(96, 165, 250, 0.3);
  color: #93c5fd;
}
.ai-mode-btn.federated .mode-pulse {
  background: var(--accent-blue);
  box-shadow: 0 0 6px var(--accent-blue);
}

/* ── Action Buttons ── */
.g-btn-row {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 26px;
}
.g-btn {
  background: var(--btn-bg);
  border: 1px solid var(--border);
  color: var(--tx);
  font-size: 14px;
  font-weight: 500;
  padding: 0 20px;
  height: 40px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.g-btn:hover {
  border-color: rgba(16, 185, 129, 0.5);
  background: var(--btn-hover);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
}

/* ── Trending Chips ── */
.trending-chips {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
  font-size: 13px;
}
.chips-label {
  color: var(--tx-muted);
  font-size: 12px;
  margin-right: 4px;
}
.chip-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--tx-sub);
  font-size: 12.5px;
  padding: 5px 13px;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.15s;
}
.chip-btn:hover {
  background: rgba(16, 185, 129, 0.12);
  border-color: var(--accent);
  color: #fff;
}

/* ── Language Line ── */
.g-lang-line {
  text-align: center;
  margin-top: 20px;
  font-size: 13px;
  color: var(--tx-muted);
}
.g-lang-line a {
  color: var(--accent-cyan);
  text-decoration: none;
  margin-left: 4px;
}
.g-lang-line a:hover {
  text-decoration: underline;
}

/* ── Sticky Footer ── */
.g-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #0c0c10;
  border-top: 1px solid var(--border-subtle);
  color: var(--tx-sub);
  font-size: 13px;
}
.g-footer-loc {
  padding: 12px 30px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
}
.loc-divider { color: var(--border); }
.footer-badge { color: var(--tx-muted); font-size: 12px; display: inline-flex; align-items: center; gap: 6px; }
.footer-badge svg { color: #fbbf24; }
.fdot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 6px rgba(52, 211, 153, 0.8);
}
.g-footer-links {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 12px 30px;
  gap: 16px;
}
.g-footer-left, .g-footer-right {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
}
.g-footer a {
  color: var(--tx-sub);
  text-decoration: none;
}
.g-footer a:hover {
  color: #fff;
  text-decoration: underline;
}

/* ── Search Mode Transition ── */
.search-mode {
  padding-top: 0;
  justify-content: flex-start;
}
.search-mode .ambient-bg { display: none; }
.search-mode .g-header { display: none; }
.search-mode .hero { display: none; }
.search-mode .g-btn-row { display: none; }
.search-mode .trending-chips { display: none; }
.search-mode .g-lang-line { display: none; }
.search-mode .g-footer { position: static; margin-top: 50px; }
.search-mode .topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 10px 28px;
  background: rgba(9, 9, 11, 0.78);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  border-bottom: 1px solid var(--border-subtle);
  width: 100%;
}
.search-mode .logo-sm {
  font-size: 1.5rem;
  font-weight: 800;
  text-decoration: none;
  color: #fff;
  letter-spacing: -0.5px;
  flex-shrink: 0;
}
.search-mode .logo-sm span { color: var(--accent); }
.search-mode .sw {
  padding: 0;
  max-width: 660px;
  flex: 1;
  margin-inline: auto;
}
.search-mode .sb { height: 48px; }

/* ── Navigation Tabs ── */
.nav {
  display: none;
  gap: 4px;
  padding: 8px 28px 0;
  max-width: 1180px;
  width: 100%;
  margin: 0 auto;
  border-bottom: 1px solid var(--border-subtle);
  overflow-x: auto;
  scrollbar-width: none;
}
.nav::-webkit-scrollbar { display: none; }
.nav.on { display: flex; }
.n {
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  color: var(--tx-sub);
  font-size: 14px;
  padding: 10px 14px 11px;
  cursor: pointer;
  white-space: nowrap;
  font-weight: 500;
  margin-bottom: -1px;
  border-radius: 8px 8px 0 0;
  transition: color 0.15s, background 0.15s;
}
.n:hover { color: var(--tx); background: rgba(255, 255, 255, 0.05); }
.n.on {
  color: var(--link);
  border-bottom-color: var(--link);
  font-weight: 600;
}

/* ── Results Container ── */
.info {
  display: none;
  color: var(--tx-muted);
  font-size: 13px;
  max-width: 1180px;
  width: 100%;
  padding: 14px 28px 4px;
  margin: 0 auto;
}
.info.on { display: block; }
.res {
  max-width: 1180px;
  width: 100%;
  padding: 16px 28px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 26px;
}

/* ── SERP 2-Column Responsive Layout ── */
.serp-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 376px;
  gap: 44px;
  width: 100%;
  align-items: start;
}
.serp-layout.no-side {
  grid-template-columns: minmax(0, 1fr);
  max-width: 740px;
}
.serp-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 26px;
}
.serp-sidebar {
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}
.serp-web-list {
  display: flex;
  flex-direction: column;
  gap: 26px;
}
@media (max-width: 991px) {
  .serp-layout,
  .serp-layout.no-side {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    max-width: 100%;
  }
  .serp-sidebar { order: -1; }
}

/* ── Knowledge Panel Card (shadcn/ui style) ── */
.kp-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 22px;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: 16px;
  position: relative;
  overflow: hidden;
}
.kp-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.kp-tag-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.kp-tag {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.6px;
  text-transform: uppercase;
}
.kp-qid {
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--tx-sub);
  font-family: monospace;
}
.kp-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.kp-title {
  font-size: 24px;
  font-weight: 700;
  color: #fff;
  line-height: 1.25;
}
.kp-ext-link {
  color: var(--tx-muted);
  display: flex;
  align-items: center;
  transition: color 0.15s;
}
.kp-ext-link:hover {
  color: var(--accent);
}
.kp-sub {
  font-size: 13px;
  color: var(--tx-sub);
}
.kp-media {
  border-radius: 12px;
  overflow: hidden;
  background: #111;
  border: 1px solid var(--border-subtle);
  max-height: 240px;
}
.kp-img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
  transition: transform 0.2s;
}
.kp-media:hover .kp-img {
  transform: scale(1.02);
}
.kp-snippet {
  font-size: 14px;
  line-height: 1.6;
  color: var(--tx-body);
}
.kp-more {
  display: inline-block;
  margin-top: 6px;
  font-size: 12px;
  color: var(--link);
  text-decoration: none;
  font-weight: 500;
}
.kp-more:hover {
  text-decoration: underline;
}
.kp-facts {
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
}
.kp-facts-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--tx-muted);
  margin-bottom: 10px;
}
.kp-dl {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.kp-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  font-size: 13px;
}
.kp-dt {
  color: var(--tx-sub);
  font-weight: 500;
  flex-shrink: 0;
  max-width: 42%;
}
.kp-dd {
  color: var(--tx);
  text-align: right;
  word-break: break-word;
}
.kp-dd a {
  color: var(--link);
  text-decoration: none;
}
.kp-dd a:hover {
  text-decoration: underline;
}
.kp-profiles {
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
}
.kp-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.kp-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--tx-sub);
  font-size: 12px;
  text-decoration: none;
  transition: all 0.15s;
}
.kp-pill:hover {
  background: rgba(138, 180, 248, 0.08);
  color: #fff;
  border-color: rgba(138, 180, 248, 0.45);
}
.kp-footer {
  border-top: 1px solid var(--border-subtle);
  padding-top: 10px;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--tx-muted);
}
.kp-footer a {
  color: var(--tx-muted);
  text-decoration: none;
}
.kp-footer a:hover {
  color: var(--accent);
}

/* ── Dictionary Card (Google/Oxford Style) ── */
.dict-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.dict-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dict-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--accent-cyan);
}
.dict-src-link {
  font-size: 12px;
  color: var(--tx-muted);
  text-decoration: none;
}
.dict-src-link:hover {
  color: var(--tx);
  text-decoration: underline;
}
.dict-word-row {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 4px;
}
.dict-word {
  font-size: 32px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.5px;
  line-height: 1.1;
}
.dict-audio-btn {
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: var(--accent);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  transition: all 0.15s;
}
.dict-audio-btn:hover {
  background: var(--accent);
  color: #000;
}
.dict-audio-waves {
  display: none;
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  animation: pulseWave 1s infinite ease-out;
  pointer-events: none;
}
.dict-audio-btn.playing .dict-audio-waves {
  display: block;
}
@keyframes pulseWave {
  0% { transform: scale(1); opacity: 0.8; }
  100% { transform: scale(1.35); opacity: 0; }
}
.dict-phonetic {
  font-size: 16px;
  color: var(--tx-sub);
  margin-top: -8px;
  font-family: 'Charis SIL', 'Doulos SIL', Gentium, serif, system-ui;
}
.dict-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 16px;
}
.dict-pos-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dict-pos-tag {
  align-self: flex-start;
  font-size: 13px;
  font-style: italic;
  font-weight: 600;
  color: var(--accent);
  background: rgba(16, 185, 129, 0.1);
  padding: 2px 10px;
  border-radius: 6px;
}
.dict-ol {
  margin: 0;
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dict-li {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--tx);
}
.dict-example {
  margin-top: 4px;
  font-size: 13.5px;
  font-style: italic;
  color: var(--tx-sub);
  border-left: 2px solid var(--border);
  padding-left: 10px;
}
.dict-footer {
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--tx-muted);
}
.dict-footer a {
  color: var(--accent-cyan);
  text-decoration: none;
}
.dict-footer a:hover {
  text-decoration: underline;
}

/* ── Featured Answer Card ── */
.ans-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-left: 4px solid var(--accent);
  border-radius: 14px;
  padding: 20px 22px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ans-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ans-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
}
.ans-source-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--tx-sub);
}
.ans-text {
  font-size: 16.5px;
  line-height: 1.6;
  color: #f8fafc;
}
.ans-cite {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 10px;
}
.ans-cite-title {
  color: var(--link);
  font-weight: 500;
  text-decoration: none;
}
.ans-cite-title:hover {
  text-decoration: underline;
}
.ans-cite-url {
  color: var(--tx-muted);
  font-size: 12px;
}

/* ── People Also Ask Accordion (shadcn/ui style) ── */
.paa-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
}
.paa-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 20px;
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  border-bottom: 1px solid var(--border-subtle);
}
.paa-accordion {
  display: flex;
  flex-direction: column;
}
.paa-item {
  border-bottom: 1px solid var(--border-subtle);
}
.paa-item:last-child {
  border-bottom: none;
}
.paa-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 20px;
  background: none;
  border: none;
  color: var(--tx);
  font-size: 14.5px;
  text-align: left;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s;
}
.paa-trigger:hover {
  background: rgba(255, 255, 255, 0.03);
}
.paa-q {
  flex: 1;
}
.paa-arrow {
  color: var(--tx-muted);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.paa-item.open .paa-arrow {
  transform: rotate(180deg);
  color: var(--accent);
}
.paa-content {
  display: none;
  padding: 0 20px 16px;
}
.paa-item.open .paa-content {
  display: block;
}
.paa-inner {
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.paa-ans {
  font-size: 14px;
  line-height: 1.6;
  color: var(--tx-body);
}
.paa-foot {
  display: flex;
  align-items: center;
}
.paa-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--link);
  text-decoration: none;
}
.paa-link:hover {
  text-decoration: underline;
}

/* ── Thinking & Interpretation Drawer ── */
.interp {
  display: none;
  max-width: 1180px;
  width: 100%;
  margin: 0 auto 12px;
  padding: 0 28px;
}
.interp.on { display: block; }
.interp-wrap {
  background: rgba(16, 185, 129, 0.05);
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: 12px;
  overflow: hidden;
}
.interp-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--tx);
  font-size: 13px;
  transition: background 0.15s;
}
.interp-toggle:hover {
  background: rgba(16, 185, 129, 0.08);
}
.interp-left {
  display: flex;
  align-items: center;
  gap: 8px;
}
.interp-sparkle { display: flex; color: #fbbf24; }
.interp-title { font-weight: 600; color: #fff; }
.interp-cat-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
  font-weight: 600;
}
.interp-right {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--tx-muted);
  font-size: 12px;
}
.interp-arrow {
  transition: transform 0.2s;
}
.interp-wrap.open .interp-arrow {
  transform: rotate(180deg);
}
.interp-details {
  display: none;
  padding: 14px 16px;
  border-top: 1px solid rgba(16, 185, 129, 0.15);
  background: rgba(0, 0, 0, 0.2);
}
.interp-wrap.open .interp-details {
  display: block;
}
.interp-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
}
.interp-cell-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--tx-muted);
  letter-spacing: 0.5px;
  margin-bottom: 4px;
}
.interp-cell-val code {
  font-family: monospace;
