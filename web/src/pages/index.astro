    ${k.snippet ? `
      <div class="kp-snippet">
        <p>${esc(k.snippet)}</p>
        ${k.url ? `<a href="${esc(k.url)}" target="_blank" rel="noopener" class="kp-more">Read on Wikipedia →</a>` : ''}
