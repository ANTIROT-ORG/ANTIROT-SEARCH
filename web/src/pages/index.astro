function renderInterp(interp: any) {
  if (!interp || (!interp.tokens?.length && !interp.category && !interp.corrected)) {
    interpEl.innerHTML = '';
    interpEl.classList.remove('on');
    return;
  }
  const expanded = interp.expanded || [];
  interpEl.innerHTML = `<div class="interp-wrap" id="interp-wrap">
    <button type="button" class="interp-toggle" id="interp-btn">
      <div class="interp-left">
        <span class="interp-sparkle"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg></span>
        <span class="interp-title">Search Heuristics & Query Interpretation</span>
        ${interp.category ? `<span class="interp-cat-badge">${esc(interp.category)}</span>` : ''}
      </div>
      <div class="interp-right">
        <span class="interp-hint">Classical IR · Zero LLM slop</span>
        <svg class="interp-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
    </button>
    <div class="interp-details" id="interp-details">
      <div class="interp-grid">
        <div class="interp-cell">
          <div class="interp-cell-label">Normalized Query</div>
          <div class="interp-cell-val"><code>${esc(interp.normalized || lastQ)}</code></div>
        </div>
        ${interp.corrected ? `
          <div class="interp-cell">
            <div class="interp-cell-label">Spell Correction</div>
            <div class="interp-cell-val"><span class="interp-corrected">${esc(interp.corrected)}</span></div>
          </div>
        ` : ''}
        <div class="interp-cell">
          <div class="interp-cell-label">Extracted Term Tokens</div>
          <div class="interp-chips">
            ${(interp.tokens || []).map((t: string) => `<span class="interp-token">${esc(t)}</span>`).join('')}
          </div>
        </div>
        ${expanded.length ? `
          <div class="interp-cell">
            <div class="interp-cell-label">PPMI Semantic Expansion</div>
            <div class="interp-chips">
              ${expanded.map((t: string) => `<span class="interp-expanded-token">+${esc(t)}</span>`).join('')}
            </div>
          </div>
        ` : ''}
      </div>
    </div>
  </div>`;
  interpEl.classList.add('on');

  const btn = $('interp-btn');
  const wrap = $('interp-wrap');
  if (btn && wrap) {
    btn.addEventListener('click', () => {
      wrap.classList.toggle('open');
    });
  }
}

function renderOps(ops: any[], when: string) {
  activeWhen = when || 'any';
  const hasOps = ops && ops.length > 0;
  const hasWhen = activeWhen && activeWhen !== 'any';
  if (!hasOps && !hasWhen) {
    opsEl.innerHTML = '';
    opsEl.classList.remove('on');
    return;
  }
  opsEl.innerHTML = `<div class="ops-container">
    <div class="ops-chips-list">
      <span class="ops-label">Active Filters:</span>
      ${(ops || []).map((c: any) => `
        <span class="ops-chip">
          <span class="ops-chip-txt">${esc(c.label)}</span>
          <button type="button" class="ops-chip-x" title="Remove filter" data-rm="${esc(c.label)}">&times;</button>
        </span>
      `).join('')}
    </div>

    <div class="ops-time-wrap">
      <label for="ops-when-select" class="ops-time-label">Time:</label>
      <select id="ops-when-select" class="ops-when-select">
        <option value="any" ${(!activeWhen || activeWhen === 'any') ? 'selected' : ''}>Any time</option>
        <option value="d" ${activeWhen === 'd' ? 'selected' : ''}>Past 24 hours</option>
        <option value="w" ${activeWhen === 'w' ? 'selected' : ''}>Past week</option>
        <option value="m" ${activeWhen === 'm' ? 'selected' : ''}>Past month</option>
        <option value="y" ${activeWhen === 'y' ? 'selected' : ''}>Past year</option>
      </select>
    </div>
  </div>`;
  opsEl.classList.add('on');

  // Handle remove chip
  opsEl.querySelectorAll('.ops-chip-x').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const rm = (e.currentTarget as HTMLElement).dataset.rm || '';
      if (!rm) return;
      let cur = qIn.value;
      cur = cur.replace(rm, '').replace(/\s+/g, ' ').trim();
      qIn.value = cur;
      doSearch(cur);
    });
  });

  // Handle time select change
  const sel = $('ops-when-select') as HTMLSelectElement;
  if (sel) {
    sel.addEventListener('change', () => {
      activeWhen = sel.value;
      doSearch(qIn.value);
    });
  }
}

function renderDym(suggestion: string | null) {
  if (!suggestion || suggestion.toLowerCase() === lastQ.toLowerCase()) {
    dymEl.innerHTML = '';
    dymEl.classList.remove('on');
    return;
  }
  dymEl.innerHTML = `<div class="dym-banner">
    <span class="dym-intro">Did you mean:</span>
    <button type="button" class="dym-btn" id="dym-action" data-q="${esc(suggestion)}">
      <em>${esc(suggestion)}</em>
    </button>
  </div>`;
  dymEl.classList.add('on');

  const action = $('dym-action');
  if (action) {
    action.addEventListener('click', () => {
      const q = action.dataset.q || '';
      if (q) {
        qIn.value = q;
        doSearch(q);
      }
    });
  }
}

